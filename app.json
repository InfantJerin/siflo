{
  "expo": {
    "name": "Siflo",
    "slug": "siflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siflo.collect"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f6b45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.siflo.collect"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbfaf6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Siflo to take photo proof during customer visits.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Siflo to record voice notes during customer visits."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-asset"
    ],
    "scheme": "siflo",
    "backgroundColor": "#fbfaf6",
    "experiments": {
      "typedRoutes": true
    }
  }
}
